# 复制本文件为同目录下的 .env 并填入真实值（.env 已被 gitignore，任何情况下不进 git）。
# 加载位置默认为仓库根目录的 .env，可用环境变量 NEWSWRIGHT_ENV_FILE 覆盖路径。

# 必需（缺失即拒绝启动）
DeepSeekAPIKey=
MoarkAPIKey=
# 初始管理员密码（D18：必填无默认，缺失即拒绝启动；不进 git/文档/日志；首登强制改密）
NEWSWRIGHT_ADMIN_PASSWORD=

# 搜索/排序（可选，缺失时对应通道降级关闭，不阻塞启动）
# bochaaiAPIKey=
# tencentSecretId=
# tencentSecretKey=

# 可选覆盖（有默认值）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# MOARK_BASE_URL=https://api.moark.com
# MOARK_JEV_MODEL=APUS-OpenJev-v1-9B
# NEWSWRIGHT_DB=sqlite:///newswright.db
